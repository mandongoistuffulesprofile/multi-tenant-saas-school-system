DATABASE_URL=postgres://skulapp_app:skulapp_app_change_in_prod@localhost:5432/skulapp?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SIGNING_KEY=dev-signing-key-change-in-production-min-32-chars
ENCRYPTION_KEY=dev-encryption-key-32-chars-long
APP_ENV=development
API_BASE_URL=/api/v1
# Leave unset in development; set to the SPA origin (e.g. https://app.example.com)
# in production instead of using the wildcard default.
CORS_ALLOWED_ORIGIN=
TIMEZONE=Africa/Nairobi
CURRENCY=KES
PORT=8080
OTP_EXPIRY_MIN=5
OTP_MAX_ATTEMPT=5
