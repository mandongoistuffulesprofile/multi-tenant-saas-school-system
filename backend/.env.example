# Local development defaults, matching infrastructure/docker/docker-compose.yml.
# The launcher (./launch_all.sh) exports these explicitly; production values
# belong in .env.prod, never here.
DATABASE_URL=postgres://school_admin:dev_secret_password@127.0.0.1:5432/school_system?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379
JWT_SIGNING_KEY=dev-signing-key-change-in-production-min-32-chars
ENCRYPTION_KEY=dev-encryption-key-32-chars-long
APP_ENV=development
API_BASE_URL=/api/v1
# Leave unset in development; set to the SPA origin (e.g. https://app.example.com)
# in production instead of using the wildcard default.
CORS_ALLOWED_ORIGIN=
TIMEZONE=Africa/Nairobi
CURRENCY=KES
PORT=8080
OTP_EXPIRY_MIN=5
OTP_MAX_ATTEMPT=5
