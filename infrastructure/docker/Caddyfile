{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Never expose metrics publicly; scrape from the private network.
	handle /metrics {
		respond "Not found" 404
	}

	# Content-hashed Vite assets are immutable — tell the browser to trust
	# them for a year so repeat visits skip re-validation entirely.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy web:80
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /webhooks/* {
		reverse_proxy api:8080
	}

	handle /health* {
		reverse_proxy api:8080
	}

	handle {
		# index.html must always revalidate so updates are discovered.
		header Cache-Control "no-cache, must-revalidate"
		reverse_proxy web:80
	}

	log {
		output stdout
		format json
	}
}
