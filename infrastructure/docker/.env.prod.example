# Copy to .env.prod and replace every value. Never commit the filled file.
DOMAIN=schools.example.com
APP_VERSION=2026.10.23

POSTGRES_USER=skulapp_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=skulapp

# --- First login (one-time, see the bootstrap step in README) --------------
# Fresh databases have no users. Fill these in, run
#   docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm bootstrap
# then clear BOOTSTRAP_PASSWORD from this file. Leave BOOTSTRAP_PASSWORD empty
# to have a password generated and printed once.
BOOTSTRAP_EMAIL=owner@your-school.example
BOOTSTRAP_PHONE=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ROLE=SAAS_ADMIN
BOOTSTRAP_TENANT=platform-ops
BOOTSTRAP_SCHOOL_NAME=Platform Operations

# 32+ random bytes, base64 or hex. Rotating this logs everyone out.
JWT_SIGNING_KEY=replace-with-32-plus-random-bytes
# 32-byte key used for encrypted learner fields.
ENCRYPTION_KEY=replace-with-32-byte-key-material

# --- M-Pesa / Daraja (OPTIONAL at go-live) -------------------------------
# Leave both blank until a school's own paybill/till credentials are being
# registered. With them blank the API records callbacks as unverified and never
# pushes STK requests, so fees, invoices and manual receipts still work.
# When a till is ready, Safaricom cannot present a JWT: put this token in the
# Daraja portal callback URL as a header (or rely on MPESA_ALLOWED_IPS).
MPESA_WEBHOOK_TOKEN=
# Optional comma-separated Safaricom egress IPs.
MPESA_ALLOWED_IPS=

# --- Email (OPTIONAL, needed for self-service password reset) --------------
# Unset = the reset email is written to the API log instead of being sent.
# Any free SMTP provider works (e.g. Brevo/Postmark free tier, or your own).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@your-domain.example
SMTP_FROM_NAME=Shule Yetu

# --- SMS (OPTIONAL, Africa's Talking) --------------------------------------
# Unset = messages are logged by the API instead of sent. Invites and fee
# receipt SMS go through this provider.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Locale defaults used for fee/report dates.
TIMEZONE=Africa/Nairobi
CURRENCY=KES

# Bearer token required by /metrics. Caddy blocks it publicly as well.
METRICS_TOKEN=replace-with-random-token
