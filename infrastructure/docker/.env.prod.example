# Copy to .env.prod and replace every value. Never commit the filled file.
DOMAIN=schools.example.com
APP_VERSION=2026.10.23

POSTGRES_USER=skulapp_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=skulapp

# 32+ random bytes, base64 or hex. Rotating this logs everyone out.
JWT_SIGNING_KEY=replace-with-32-plus-random-bytes
# 32-byte key used for encrypted learner fields.
ENCRYPTION_KEY=replace-with-32-byte-key-material

# Safaricom cannot present a JWT. Set this in the Daraja portal callback URL as
# a header (or rely on MPESA_ALLOWED_IPS). Generate with: openssl rand -hex 32
MPESA_WEBHOOK_TOKEN=replace-with-random-token
# Optional comma-separated Safaricom egress IPs.
MPESA_ALLOWED_IPS=

# Bearer token required by /metrics. Caddy blocks it publicly as well.
METRICS_TOKEN=replace-with-random-token
