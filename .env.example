# PostgreSQL connection
DATABASE_URL=postgres://auth:auth@localhost:5432/authdb

# Redis (rate limiting + session store)
REDIS_URL=redis://127.0.0.1:6379/0

# Email via SES (or any SMTP)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIA...
SMTP_PASS=...
EMAIL_FROM=noreply@yourapp.com
EMAIL_FROM_NAME=YourApp Support
RESET_EMAIL_SUBJECT=Reset your password
PASSWORD_CHANGED_SUBJECT=Your password was changed

# App
APP_NAME=YourApp
APP_URL=https://yourapp.com
NODE_ENV=production

# Secrets manager pepper (optional — store in AWS Secrets Manager / Vault)
# PEPPER=<base64>

# HaveIBeenPwned k-anonymity API
HIBP_API_URL=https://haveibeenpwned.com/api/v3/breached/

# Session
JWT_SECRET=<64-byte-random>
SESSION_COOKIE_NAME=sid
SESSION_COOKIE_MAX_AGE=86400000  # 10 days

# Rate limit thresholds
MAX_RESET_REQUESTS_PER_EMAIL_PER_MIN=3
MAX_RESET_REQUESTS_PER_IP_PER_MIN=10
GLOBAL_RESET_VELOCITY_PER_MIN=100
MAX_LOGIN_ATTEMPTS_PER_ACCOUNT=10
MAX_LOGIN_ATTEMPTS_PER_IP_PER_MIN=20
LOGIN_LOCKOUT_MS=900000  # 15 min

# Argon2
ARGON2_MEMORY=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=4